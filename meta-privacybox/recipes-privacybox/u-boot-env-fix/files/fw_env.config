# Configuration file for fw_(printenv/setenv) utility.
# Block device name	Device offset	Env. size
# Environment: 16MB (0x1000000) - In free unpartitioned space before first partition
# Boot partition starts: 64MB (well after environment)
# This ensures environment is in raw space, not inside any partition
# Original NXP BSP default (0x700000 = 7MB) is INSIDE boot partition and gets corrupted by FAT writes
/dev/mmcblk1		0x1000000		0x4000

